<Window x:Class="StockIpoReminder.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新股申购提醒" Width="470" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ShowActivated="False"
        Style="{StaticResource AppWindowStyle}"
        Topmost="True">
    <Border Background="#111B2E" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Border x:Name="LevelBadge" Background="#1D4ED8" CornerRadius="6" Padding="8,4" DockPanel.Dock="Right">
                    <TextBlock x:Name="LevelText" FontWeight="Bold" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="NameText" AutomationProperties.AutomationId="ReminderName" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="CodeText" Foreground="#93C5FD" FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Margin="0,16,0,12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="申购日期" Foreground="#94A3B8" />
                        <TextBlock x:Name="DateText" FontSize="16" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Text="发行价格" Foreground="#94A3B8" Margin="0,8,0,0" />
                        <TextBlock x:Name="PriceText" FontSize="16" FontWeight="SemiBold" Margin="0,3" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="申购上限 / 单位" Foreground="#94A3B8" />
                        <TextBlock x:Name="QuantityText" FontSize="16" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Text="安全截止" Foreground="#94A3B8" Margin="0,8,0,0" />
                        <TextBlock x:Name="CutoffText" FontSize="16" FontWeight="SemiBold" Margin="0,3" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="WarningPanel" Grid.Row="2" Background="#3A2510" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="WarningText" AutomationProperties.AutomationId="ReminderWarning" Foreground="#FCD34D" TextWrapping="Wrap" />
            </Border>
            <TextBlock Grid.Row="3" Foreground="#94A3B8" TextWrapping="Wrap"
                       Text="本程序不会检查券商委托是否成功。只有点击“确认已申购”并完成二次确认，后续重复提醒才会停止。" />
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="打开详情" Click="OpenDetails_Click" />
                <Button Grid.Column="1" Content="稍后处理" Click="Later_Click" />
                <Button Grid.Column="2" AutomationProperties.AutomationId="ConfirmSubscription" Content="确认已申购" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
