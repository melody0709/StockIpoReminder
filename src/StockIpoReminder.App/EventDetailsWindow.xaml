<Window x:Class="StockIpoReminder.App.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="申购任务详情" Width="960" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Border x:Name="QualityBadge" Background="#1D4ED8" CornerRadius="6" Padding="8,4" DockPanel.Dock="Right">
                    <TextBlock x:Name="QualityText" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" />
            </DockPanel>
            <TextBlock x:Name="SummaryText" Foreground="#93C5FD" Margin="0,5,0,0" />
            <TextBlock x:Name="WarningText" Foreground="#FCD34D" Margin="0,7,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="DetailsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="字段来源">
                <Grid Margin="0,12,0,0">
                    <ListView x:Name="FieldSourceList" AutomationProperties.AutomationId="FieldSources" Background="#0F172A" BorderBrush="#26334A">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="字段" Width="130" DisplayMemberBinding="{Binding FieldName}" />
                                <GridViewColumn Header="标准化值" Width="165" DisplayMemberBinding="{Binding NormalizedValue}" />
                                <GridViewColumn Header="来源" Width="145" DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="优先级" Width="65" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="抓取时间" Width="140" DisplayMemberBinding="{Binding FetchedText}" />
                                <GridViewColumn Header="原始值/依据" Width="215" DisplayMemberBinding="{Binding RawValue}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="FieldSourceEmptyText" Text="尚无可显示的字段来源记录。"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                </Grid>
            </TabItem>

            <TabItem Header="正式公告">
                <Grid Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AnnouncementItems" AutomationProperties.AutomationId="AnnouncementEvidence">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Metadata}" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding Evidence}" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="打开原文" Tag="{Binding Document}" Click="OpenAnnouncement_Click" />
                                                <Button Content="打开本地文件" Tag="{Binding Document}" Click="OpenLocalAnnouncement_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="AnnouncementEmptyText" Text="尚未下载到相关正式公告；任务仍会保留并继续提醒。"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                </Grid>
            </TabItem>

            <TabItem Header="人工核验与覆盖">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#3A2510" BorderBrush="#D97706" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                            <TextBlock Foreground="#FCD34D" TextWrapping="Wrap"
                                       Text="仅在核对正式公告后使用。人工覆盖会记录字段、值、理由、依据公告和当前发行版本；外部关键数据形成新版本后不会沿用旧覆盖。" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="覆盖字段" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OverrideFieldCombo" Margin="4" Padding="8,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="覆盖值" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="OverrideValueText" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="核验理由" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="OverrideReasonText" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="依据公告（可选）" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="OverrideAnnouncementCombo" Margin="4" Padding="8,6" DisplayMemberPath="Title" />
                        </Grid>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,14">
                            <TextBlock x:Name="OverrideStatusText" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0" />
                            <Button Content="保存人工覆盖" Style="{StaticResource PrimaryButton}" Click="SaveOverride_Click" />
                        </WrapPanel>
                        <TextBlock Text="当前版本的人工覆盖记录" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,9" />
                        <ItemsControl x:Name="OverrideItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Metadata}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="撤销覆盖" Tag="{Binding Entry}" Click="RevokeOverride_Click"
                                                    Visibility="{Binding RevokeVisibility}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#94A3B8"
                   Text="本程序无法验证券商端是否已经提交成功。关闭详情页不会改变确认状态。" />
    </Grid>
</Window>
