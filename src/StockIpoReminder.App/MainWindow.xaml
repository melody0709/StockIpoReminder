<Window x:Class="StockIpoReminder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A 股新股申购提醒"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <DataTemplate x:Key="EventCardTemplate">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <DockPanel>
                            <Border Background="{Binding StatusBrush}" CornerRadius="5" Padding="7,3"
                                    DockPanel.Dock="Right" Margin="8,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" />
                        </DockPanel>
                        <TextBlock Text="{Binding MarketAndCodes}" Foreground="#93C5FD" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding WarningText}" Foreground="#FBBF24" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding WarningVisibility}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="申购日 / 安全截止" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DateAndCutoff}" FontWeight="SemiBold" Margin="0,4,0,8" />
                        <TextBlock Text="发行价 / 上限 / 单位" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding NumbersText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="官方申购时段" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding SessionText}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding QualityText}" Foreground="{Binding QualityBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdatedText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" MinWidth="132" VerticalAlignment="Center">
                        <Button Content="查看详情" Tag="{Binding Event}" Click="OpenDetails_Click" />
                        <Button Content="{Binding ConfirmButtonText}" Tag="{Binding Event}"
                                Style="{StaticResource PrimaryButton}" Click="ConfirmEvent_Click"
                                Visibility="{Binding ConfirmVisibility}" />
                        <Button Content="撤销确认" Tag="{Binding Event}" Click="RevokeEvent_Click"
                                Visibility="{Binding RevokeVisibility}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceHealthTemplate">
            <Border Background="#0F172A" BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Source}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{Binding StateBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding RecordText}" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding LastSuccessText}" Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="A 股新股申购提醒" FontSize="28" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="RuntimeDot" Width="9" Height="9" Fill="#F59E0B" Margin="0,4,8,0" />
                    <TextBlock x:Name="RuntimeStatusText" Text="正在启动" />
                    <TextBlock Text=" · " Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="LastSyncText" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SyncButton" Content="立即同步" Style="{StaticResource PrimaryButton}" Click="SyncButton_Click" />
                <Button Content="隐藏到托盘" Click="HideButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="今日任务">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="今日任务" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock x:Name="TodayCountText" AutomationProperties.AutomationId="TodayTaskCount" Text="0" FontSize="28" FontWeight="Bold" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="待确认" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock x:Name="PendingCountText" AutomationProperties.AutomationId="PendingTaskCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FCA5A5" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="已确认" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock x:Name="AcknowledgedCountText" AutomationProperties.AutomationId="AcknowledgedTaskCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#86EFAC" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel><TextBlock Text="异常数据" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock x:Name="IssueCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FCD34D" /></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TodayItems" AutomationProperties.AutomationId="TodayTaskCards" ItemTemplate="{StaticResource EventCardTemplate}" />
                        </ScrollViewer>
                        <TextBlock x:Name="TodayEmptyText" Text="今天暂未发现新股申购任务。请同时确认上方同步状态正常。"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="未来日历">
                <Grid Margin="0,14,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FutureItems" ItemTemplate="{StaticResource EventCardTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="FutureEmptyText" Text="未来 60 天暂未发现可展示的申购任务。"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </TabItem>

            <TabItem Header="健康与诊断">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HealthTitleText" Text="正在读取健康状态" FontSize="22" FontWeight="Bold" />
                                    <TextBlock x:Name="HealthSummaryText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HeartbeatText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="ClockStatusText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="刷新诊断" Click="RefreshButton_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Text="数据源" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10" />
                        <ItemsControl x:Name="SourceHealthItems" ItemTemplate="{StaticResource SourceHealthTemplate}" />
                        <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="本地诊断" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="DataPathText" AutomationProperties.AutomationId="DataRootPath" Margin="0,7,0,10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                                    <Button Content="复制诊断摘要" Click="CopyDiagnostics_Click" />
                                    <Button Content="导出脱敏诊断包" Click="ExportDiagnostics_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="设置">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border x:Name="FirstRunPanel" Background="#3A2510" BorderBrush="#D97706" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <TextBlock Foreground="#FCD34D" TextWrapping="Wrap"
                                       Text="首次使用请确认市场、券商受理时间和安全截止时间，并完成一次提醒通道测试。测试通过之前，程序会持续显示此提示。" />
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="启用市场" FontSize="19" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="ShanghaiEnabledCheck" Content="沪市主板 / 科创板" />
                                    <CheckBox x:Name="ShenzhenEnabledCheck" Content="深市主板 / 创业板" />
                                    <CheckBox x:Name="BeijingEnabledCheck" Content="北交所" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="券商受理与安全截止" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="时间格式 HH:mm。安全截止不得晚于 15:00，建议保留几分钟券商处理余量。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" /><ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="170" /><ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="沪市券商受理开始" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ShanghaiStartText" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="深市券商受理开始" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="ShenzhenStartText" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="北交所券商受理开始" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BeijingStartText" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="安全截止时间" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="SafetyCutoffText" />
                                </Grid>
                                <CheckBox x:Name="BeijingReservationCheck" Content="我的券商支持北交所开盘前预约申购" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="提醒通道" FontSize="19" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="SoundCheck" Content="声音" />
                                    <CheckBox x:Name="FlashCheck" Content="临近截止闪烁任务栏" />
                                    <CheckBox x:Name="ToastCheck" Content="Windows Toast（仅打开任务）" />
                                    <CheckBox x:Name="HealthSummaryCheck" Content="每日 08:00 健康摘要" />
                                    <CheckBox x:Name="AutoStartCheck" Content="登录 Windows 后自动启动" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="测试所有提醒通道" Click="TestNotification_Click" />
                                    <TextBlock x:Name="NotificationTestStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FCD34D" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="同步频率" FontSize="19" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="130" /><ColumnDefinition Width="210" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="普通日期（分钟）" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="NormalSyncText" />
                                    <TextBlock Grid.Column="2" Text="有未确认任务时（分钟）" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" x:Name="ActiveSyncText" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="本程序只记录你的人工确认，不连接券商、不自动下单，也无法验证券商委托是否成功。" />
    </Grid>
</Window>
