import { ComboBox, HorizontalBox, LineEdit, ListView, ScrollView, VerticalBox } from "std-widgets.slint";

export struct TaskRow {
    event-id: string,
    event-version: int,
    name: string,
    market-and-codes: string,
    date-and-cutoff: string,
    numbers: string,
    session: string,
    status: string,
    quality: string,
    updated: string,
    warning: string,
    needs-review: bool,
    can-acknowledge: bool,
    can-revoke: bool,
    confirm-label: string,
}

export struct SourceHealthRow {
    source: string,
    state: string,
    record-text: string,
    last-success-text: string,
    error-text: string,
    state-level: int,
}

export struct FieldSourceRow {
    field-name: string,
    normalized-value: string,
    raw-value: string,
    source-text: string,
    fetched-text: string,
}

export struct AnnouncementRow {
    id: string,
    title: string,
    metadata: string,
    evidence: string,
    source-url: string,
    local-path: string,
    local-available: bool,
}

export struct OverrideRow {
    id: string,
    summary: string,
    metadata: string,
    can-revoke: bool,
}

export struct CreditCardRow {
    id: string,
    alias: string,
    account-kind: string,
    bank: string,
    bank-icon: image,
    due-text: string,
    status-text: string,
    status-tone: int,
    lead-text: string,
    remind-text: string,
    final-cycle-text: string,
    cycle-key: string,
    enabled: bool,
    can-pay: bool,
    can-undo: bool,
    is-loan: bool,
    closed: bool,
    action-rows: int,
}

component UpdatePill inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 92px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 999px;
    border-width: 0px;
    background: !root.enabled ? #1b2537 : touch.has-hover ? #16a34a : #22c55e;
    Text {
        text: root.label;
        color: root.enabled ? #04250f : #64748b;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked();
    min-width: root.compact ? 88px : 104px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled ? #334155 : root.danger ? #dc2626 : root.primary ? #3b82f6 : #334155;
    background: !root.enabled ? #172033 : touch.has-hover ? (root.danger ? #991b1b : root.primary ? #2563eb : #253552) : (root.danger ? #7f1d1d : root.primary ? #1d4ed8 : #17233a);
    Text {
        text: root.label;
        color: root.enabled ? #f8fafc : #64748b;
        font-size: root.compact ? 13px : 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> compact: false;
    callback clicked();
    min-width: root.compact ? 100px : 128px;
    min-height: root.compact ? 38px : 42px;
    max-height: root.compact ? 38px : 42px;
    border-radius: 8px;
    background: root.selected ? #1d4ed8 : touch.has-hover ? #253552 : #111b2e;
    Text {
        text: root.label;
        color: root.selected ? white : #cbd5e1;
        font-size: root.compact ? 13px : 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> compact: false;
    callback clicked();
    min-width: root.compact ? 92px : 118px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? #3b82f6 : #334155;
    background: root.selected ? #1d4ed8 : touch.has-hover ? #253552 : #17233a;
    Text {
        text: root.label;
        color: root.selected ? white : #cbd5e1;
        font-size: root.compact ? 13px : 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    in property <bool> enabled: true;
    callback edited();
    min-width: 174px;
    min-height: 34px;
    max-height: 34px;
    background: transparent;
    HorizontalBox {
        spacing: 9px;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 5px;
            border-width: 1px;
            border-color: !root.enabled ? #334155 : root.checked ? #60a5fa : #52647d;
            background: !root.enabled ? #172033 : root.checked ? #2563eb : #0f172a;
            Text {
                text: root.checked ? "✓" : "";
                color: white;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.enabled ? #e2e8f0 : #64748b;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.edited();
            }
        }
    }
}

component NotificationTestItem inherits Rectangle {
    in property <string> label;
    in property <string> status;
    in property <int> level: 0;
    in property <bool> compact: false;
    callback clicked();
    min-width: root.compact ? 250px : 320px;
    min-height: 40px;
    max-height: 40px;
    background: transparent;
    HorizontalBox {
        spacing: 8px;
        ActionButton {
            label: root.label;
            compact: root.compact;
            clicked => { root.clicked(); }
        }
        Text {
            text: root.status;
            color: root.level == 1 ? #86efac : root.level == 2 ? #fca5a5 : #fcd34d;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: #f8fafc;
    in property <bool> compact: false;
    min-height: root.compact ? 70px : 82px;
    max-height: root.compact ? 70px : 82px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #26334a;
    background: #111b2e;
    VerticalBox {
        padding: root.compact ? 9px : 12px;
        spacing: 3px;
        Text { text: root.label; color: #94a3b8; font-size: root.compact ? 12px : 13px; }
        Text { text: root.value; color: root.value-color; font-size: root.compact ? 22px : 26px; font-weight: 700; }
    }
}

component LabeledInput inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder: "";
    min-width: 180px;
    min-height: 62px;
    max-height: 62px;
    background: transparent;
    VerticalBox {
        spacing: 4px;
        Text { text: root.label; color: #94a3b8; font-size: 12px; }
        LineEdit { text <=> root.value; placeholder-text: root.placeholder; }
    }
}

export component MainWindow inherits Window {
    title: "A 股新股申购提醒";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 800px;
    min-height: 500px;
    // 显式给出 max，防止页面布局的 max 约束泄漏到窗口级：
    // Slint 会把根布局约束当作窗口 min/max 尺寸并在切页时强制钳制，
    // 逆回购页「提醒时段」整行固定宽（width 同时是 min 和 max）曾把窗口
    // 锁进约 654–800px 宽且无法拉伸。10000 与 window_state.rs 的
    // MAX_LOGICAL_DIMENSION 一致，实际等同不设上限。
    max-width: 10000px;
    max-height: 10000px;
    // Toggling repaint-token marks the complete window background dirty. This
    // is used when a tray-resident software-rendered window becomes visible
    // again, because a plain request-redraw may otherwise repaint only the
    // previously dirty child region.
    background: Math.mod(root.repaint-token, 2) == 0 ? #0b1220 : #0b1221;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    always-on-top: root.show-reminder || root.show-notification-confirmation || root.show-confirmation || root.show-override-confirmation || root.show-uninstall-confirmation || root.show-exit-confirmation;

    in-out property <int> active-page: 0;
    in-out property <int> repaint-token: 0;
    in-out property <bool> is-synchronizing: false;
    in-out property <int> runtime-level: 0;
    in-out property <bool> compact-width: false;
    in-out property <bool> compact-height: false;
    in-out property <bool> show-nav-health: true;
    // 还款页的 ScrollView 必须有确定的可视高度，否则会按内容撑出窗口；在窗口高度变化时换算一次，避免布局循环。
    in-out property <length> repayment-page-height: 510px;
    changed width => { root.compact-width = root.width < 1000px; root.show-nav-health = root.width >= 1120px; }
    changed height => {
        root.compact-height = root.height < 650px;
        root.repayment-page-height = Math.max(160px, root.height - 270px);
    }
    in property <string> app-version: "";
    in-out property <string> status-text: "正在初始化…";
    in-out property <string> sync-text: "尚未同步";
    in-out property <string> health-text: "正在读取健康状态…";
    in-out property <string> clock-text: "系统时间尚未检查";

    in-out property <int> today-count: 0;
    in-out property <int> pending-count: 0;
    in-out property <int> acknowledged-count: 0;
    in-out property <int> issue-count: 0;
    in-out property <[TaskRow]> today-tasks: [];
    in-out property <[TaskRow]> future-tasks: [];
    in-out property <string> task-filter-text: "";
    in-out property <int> task-market-filter-index: 0;
    in-out property <int> task-status-filter-index: 0;
    in-out property <int> today-visible-count: 0;
    in-out property <int> future-count: 0;
    in-out property <int> future-visible-count: 0;

    in-out property <string> health-title: "健康状态尚未建立";
    in-out property <string> health-summary: "";
    in-out property <string> heartbeat-text: "";
    in-out property <[SourceHealthRow]> source-health: [];
    in-out property <string> data-root-text: "";

    in-out property <bool> auto-start: true;
    in-out property <bool> shanghai-enabled: true;
    in-out property <bool> shenzhen-enabled: true;
    in-out property <bool> beijing-enabled: true;
    in-out property <string> shanghai-start: "09:30";
    in-out property <string> shenzhen-start: "09:15";
    in-out property <string> beijing-start: "09:15";
    in-out property <string> safety-cutoff: "14:55";
    in-out property <bool> beijing-reservation: false;
    in-out property <bool> sound-enabled: true;
    in-out property <bool> toast-enabled: true;
    in-out property <bool> health-summary-enabled: true;
    in-out property <bool> post-apply-reminders-enabled: true;
    in-out property <bool> listing-reminders-enabled: true;
    in-out property <bool> notification-test-completed: false;
    in-out property <bool> onboarding-completed: false;
    in-out property <string> notification-test-status: "尚未完成提醒通道测试";
    in-out property <string> notification-platform-status: "Windows Toast：正在诊断";
    in-out property <string> notification-window-test-status: "未测试";
    in-out property <string> notification-toast-test-status: "未测试";
    in-out property <string> notification-balloon-test-status: "未测试";
    in-out property <string> notification-sound-test-status: "未测试";
    in-out property <int> notification-window-test-level: 0;
    in-out property <int> notification-platform-level: 0;
    in-out property <int> notification-toast-test-level: 0;
    in-out property <int> notification-balloon-test-level: 0;
    in-out property <int> notification-sound-test-level: 0;
    in-out property <int> notification-test-channel: -1;
    in-out property <string> notification-test-title: "确认提醒通道测试";
    in-out property <string> notification-test-question: "你是否观察到刚才的测试？";
    in-out property <string> normal-sync-interval-value: "30";
    in-out property <int> normal-sync-interval-unit-index: 0;
    in-out property <string> active-sync-interval-value: "20";
    in-out property <int> active-sync-interval-unit-index: 0;
    in-out property <bool> reset-settings-pending: false;
    in-out property <int> settings-section: 0;
    in-out property <bool> automatic-updates-enabled: false;
    in-out property <bool> automatic-update-download-enabled: false;
    in-out property <bool> update-configured: false;
    in-out property <bool> update-available: false;
    in-out property <bool> update-ready: false;
    in-out property <bool> update-downloading: false;
    in-out property <bool> update-download-failed: false;
    in-out property <int> update-download-progress: -1;
    in-out property <string> update-version: "";
    in-out property <string> update-release-notes-url: "";
    in-out property <string> update-status: "正在读取安全更新配置…";
    in-out property <bool> update-pill-visible: false;
    in-out property <string> update-pill-label: "";
    in-out property <bool> update-pill-enabled: true;
    in-out property <bool> update-pill-manual-only: false;
    in-out property <string> update-note: "";
    in-out property <int> update-note-tone: 0;
    in-out property <int> update-progress: -1;
    in-out property <bool> crash-upload-enabled: false;
    in-out property <bool> crash-upload-configured: false;
    in-out property <bool> crash-upload-busy: false;
    in-out property <string> crash-upload-status: "正在读取崩溃报告共享配置…";
    in-out property <string> crash-upload-privacy-url: "";
    in-out property <bool> secondary-notification-enabled: false;
    in-out property <int> secondary-notification-provider-index: 0;
    in-out property <string> secondary-notification-secret-entry: "";
    in-out property <bool> secondary-notification-configured: false;
    in-out property <bool> secondary-notification-busy: false;
    in-out property <string> secondary-notification-status: "正在读取第二通知通道配置…";
    in-out property <bool> uninstall-available: false;
    in-out property <string> uninstall-status: "正在检查 MSI 安装状态…";
    in-out property <bool> show-uninstall-confirmation: false;
    in-out property <bool> uninstall-purge-data: false;
    in-out property <string> uninstall-confirmation-text: "";

    in-out property <bool> repo-enabled: false;
    in-out property <bool> repo-primary-enabled: true;
    in-out property <string> repo-primary-time: "14:50";
    in-out property <bool> repo-fallback-enabled: false;
    in-out property <string> repo-fallback-time: "15:20";
    in-out property <string> repo-status: "逆回购提醒尚未启用";
    in-out property <string> repo-status-detail: "";
    in-out property <string> repo-calendar-text: "";
    in-out property <bool> repo-calendar-warning: true;
    in-out property <bool> repo-acked: false;
    in-out property <string> repo-error: "";
    // 用户改过逆回购表单但还没保存。置位后后台刷新不得把数据库里的旧值写回输入框。
    in-out property <bool> repo-form-dirty: false;

    in-out property <[CreditCardRow]> credit-cards: [];
    in-out property <[string]> credit-bank-options: [];
    in-out property <[string]> credit-bank-ids: [];
    in-out property <[string]> credit-due-day-options: [];
    in-out property <string> credit-summary: "暂无还款提醒";
    in-out property <string> credit-form-id: "";
    in-out property <int> credit-form-kind-index: 0;
    in-out property <string> credit-form-alias: "";
    in-out property <bool> credit-form-alias-manual: false;
    in-out property <int> credit-form-bank-index: 0;
    in-out property <image> credit-form-bank-icon: @image-url("../assets/banks/kind_credit_card.svg");
    in-out property <string> credit-form-bank-name: "";
    in-out property <bool> credit-form-bank-custom: false;
    in-out property <int> credit-form-due-day-index: 4;
    in-out property <string> credit-form-remind-time: "09:00";
    in-out property <int> credit-form-lead-mode-index: 2;
    in-out property <string> credit-form-lead-days: "3,0";
    in-out property <string> credit-form-final-cycle: "";
    in-out property <bool> credit-form-overdue: true;
    in-out property <bool> credit-form-enabled: true;
    in-out property <bool> credit-form-editing: false;
    in-out property <bool> credit-form-visible: false;
    in-out property <string> credit-form-preview: "";
    in-out property <string> credit-highlight-id: "";
    in-out property <string> credit-error: "";
    // 非空表示「已请求删除该账户，等待二次确认」；只存 account id，避免额外模态窗口。
    in-out property <string> credit-confirm-delete: "";
    in-out property <string> credit-confirm-close: "";

    in-out property <bool> show-details: false;
    in-out property <string> selected-event-id: "";
    in-out property <int> selected-event-version: 0;
    in-out property <string> selected-title: "";
    in-out property <string> selected-detail: "";
    in-out property <string> selected-summary: "";
    in-out property <string> selected-warning: "";
    in-out property <string> selected-quality: "";
    in-out property <bool> selected-quality-alert: false;
    in-out property <int> details-active-tab: 0;
    in-out property <[FieldSourceRow]> field-source-rows: [];
    in-out property <[AnnouncementRow]> announcement-rows: [];
    in-out property <[string]> announcement-choices: ["不指定公告"];
    in-out property <[OverrideRow]> override-rows: [];
    in-out property <int> override-field-index: 0;
    in-out property <int> override-announcement-index: 0;
    in-out property <string> override-value: "";
    in-out property <string> override-reason: "";
    in-out property <string> override-status: "";

    in-out property <bool> show-override-confirmation: false;
    in-out property <bool> override-confirmation-is-revoke: false;
    in-out property <string> override-confirmation-id: "";
    in-out property <string> override-confirmation-title: "";
    in-out property <string> override-confirmation-body: "";

    in-out property <bool> show-confirmation: false;
    in-out property <bool> confirmation-is-revoke: false;
    in-out property <string> confirmation-event-id: "";
    in-out property <int> confirmation-event-version: 0;
    in-out property <string> confirmation-title: "";
    in-out property <string> confirmation-body: "";

    in-out property <bool> show-reminder: false;
    in-out property <string> reminder-title: "";
    in-out property <string> reminder-body: "";
    in-out property <string> reminder-event-id: "";
    in-out property <int> reminder-event-version: 0;
    in-out property <bool> show-notification-confirmation: false;
    in-out property <bool> show-exit-confirmation: false;

    callback save-settings();
    callback reset-settings();
    callback sync-now();
    callback refresh-data();
    callback select-task(string);
    callback acknowledge(string, int);
    callback revoke-acknowledgement(string, int);
    callback apply-override(string, int, int, string, string, int);
    callback revoke-override(string, int, string);
    callback open-external(string);
    callback open-local(string);
    callback create-diagnostics();
    callback open-data-folder();
    callback copy-diagnostics();
    callback test-notification-channel(int);
    callback complete-notification-test(int, bool);
    callback check-for-updates();
    callback request-update();
    callback dismiss-update();
    callback open-update-download();
    callback open-update-settings();
    callback open-release-notes();
    callback upload-crash-report();
    callback open-crash-upload-privacy();
    callback test-secondary-notification();
    callback clear-secondary-notification-secret();
    callback request-uninstall(bool, string);
    callback save-repo-settings(bool, bool, string, bool, string);
    callback set-repo-acked(bool);
    callback save-credit-card(string, int, string, int, string, int, string, int, string, string, bool, bool);
    callback delete-credit-card(string);
    callback edit-credit-card(string);
    callback clear-credit-editor();
    callback mark-credit-paid(string, string);
    callback undo-credit-action(string);
    callback close-credit-account(string);
    callback resume-credit-account(string);
    callback preview-credit-form();
    callback hide-to-tray();
    callback exit-app();

    VerticalBox {
        padding-left: root.compact-width ? 12px : 20px;
        padding-right: root.compact-width ? 12px : 20px;
        padding-top: root.compact-height ? 14px : 20px;
        padding-bottom: root.compact-height ? 14px : 20px;
        spacing: root.compact-height ? 8px : 12px;

        VerticalBox {
            min-height: root.compact-height ? 80px : 86px;
            max-height: root.compact-height ? 80px : 86px;
            spacing: root.compact-height ? 6px : 8px;
            HorizontalBox {
                min-height: root.compact-height ? 40px : 46px;
                max-height: root.compact-height ? 40px : 46px;
                spacing: root.compact-width ? 8px : 12px;
                Text {
                    text: "A 股新股申购提醒";
                    min-height: root.compact-height ? 40px : 46px;
                    max-height: root.compact-height ? 40px : 46px;
                    font-size: root.compact-width ? 23px : 27px;
                    font-weight: 700;
                    color: #f8fafc;
                    vertical-alignment: center;
                }
                Rectangle {
                    min-width: root.compact-width ? 56px : 62px;
                    max-width: root.compact-width ? 56px : 62px;
                    min-height: 24px;
                    max-height: 24px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: hover-touch.has-hover ? #60a5fa : #3b82f6;
                    background: hover-touch.has-hover ? #1e3a8a : #172554;
                    Text {
                        text: "v" + root.app-version;
                        color: #93c5fd;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    hover-touch := TouchArea {
                        clicked => { root.open-update-settings(); }
                    }
                }
                if root.update-pill-visible : UpdatePill {
                    label: root.update-pill-label;
                    enabled: root.update-pill-enabled;
                    clicked => { root.request-update(); }
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { label: "立即同步"; compact: root.compact-width; primary: true; enabled: !root.is-synchronizing; clicked => { root.sync-now(); } }
                ActionButton { label: "隐藏到托盘"; compact: root.compact-width; clicked => { root.hide-to-tray(); } }
            }
            Rectangle {
                min-height: root.compact-height ? 30px : 32px;
                max-height: root.compact-height ? 30px : 32px;
                background: transparent;
                HorizontalBox {
                    spacing: root.compact-width ? 6px : 8px;
                    Rectangle { min-width: root.compact-height ? 8px : 10px; max-width: root.compact-height ? 8px : 10px; min-height: root.compact-height ? 8px : 10px; max-height: root.compact-height ? 8px : 10px; border-radius: 5px; background: root.is-synchronizing ? #f59e0b : root.runtime-level == 2 ? #ef4444 : root.runtime-level == 1 ? #22c55e : #f59e0b; }
                    Text {
                        text: root.status-text + " · " + root.sync-text;
                        color: #a8b5ca;
                        font-size: 13px;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }

        if root.update-note != "" : Rectangle {
            min-height: 38px;
            background: transparent;
            HorizontalBox {
                spacing: root.compact-width ? 6px : 8px;
                Text {
                    text: root.update-note;
                    color: root.update-note-tone == 1 ? #86efac : root.update-note-tone == 2 ? #fcd34d : root.update-note-tone == 3 ? #f09595 : #cbd5e1;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                if root.update-progress >= 0 : Rectangle {
                    min-width: root.compact-width ? 80px : 140px;
                    max-width: root.compact-width ? 80px : 140px;
                    min-height: 6px;
                    max-height: 6px;
                    border-radius: 3px;
                    background: #1b2537;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.update-progress / 100;
                        height: parent.height;
                        border-radius: 3px;
                        background: #22c55e;
                    }
                }
                if root.update-pill-manual-only : ActionButton { label: "手动下载"; compact: root.compact-width; clicked => { root.open-update-download(); } }
                if root.update-pill-visible && root.update-pill-enabled && root.update-progress < 0 : ActionButton { label: "稍后"; compact: root.compact-width; clicked => { root.dismiss-update(); } }
            }
        }

        HorizontalBox {
            min-height: root.compact-height ? 38px : 42px;
            max-height: root.compact-height ? 38px : 42px;
            spacing: 6px;
            NavButton { label: "今日任务"; compact: root.compact-width; selected: root.active-page == 0; clicked => { root.active-page = 0; } }
            NavButton { label: "未来 60 天"; compact: root.compact-width; selected: root.active-page == 1; clicked => { root.active-page = 1; } }
            NavButton { label: "逆回购"; compact: root.compact-width; selected: root.active-page == 4; clicked => { root.active-page = 4; } }
            NavButton { label: "还款提醒"; compact: root.compact-width; selected: root.active-page == 5; clicked => { root.active-page = 5; } }
            NavButton { label: "健康与诊断"; compact: root.compact-width; selected: root.active-page == 2; clicked => { root.active-page = 2; } }
            NavButton { label: "设置"; compact: root.compact-width; selected: root.active-page == 3; clicked => { root.active-page = 3; } }
            // 六个导航项已经占掉约 798px，健康摘要剩余空间有限：
            // 交给它自己吃掉剩余宽度并省略号收尾，避免在窗口右边缘被硬裁掉半句。
            if root.show-nav-health : Text {
                text: root.health-text;
                color: #94a3b8;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        if root.active-page == 0 || root.active-page == 1 : HorizontalBox {
            min-height: 34px;
            max-height: 34px;
            spacing: root.compact-width ? 6px : 10px;
            Text { text: "筛选"; color: #cbd5e1; vertical-alignment: center; }
            LineEdit {
                width: root.compact-width ? 180px : 280px;
                text <=> root.task-filter-text;
                placeholder-text: "简称、股票代码或申购代码";
                edited => { root.refresh-data(); }
            }
            ComboBox {
                width: root.compact-width ? 100px : 120px;
                model: ["全部市场", "沪市", "深市", "北交所"];
                current-index <=> root.task-market-filter-index;
                selected => { root.refresh-data(); }
            }
            ComboBox {
                width: root.compact-width ? 100px : 120px;
                model: ["全部状态", "待确认", "已确认", "需核验"];
                current-index <=> root.task-status-filter-index;
                selected => { root.refresh-data(); }
            }
            Text {
                text: root.active-page == 0
                    ? "显示 " + root.today-visible-count + " / " + root.today-count
                    : "显示 " + root.future-visible-count + " / " + root.future-count;
                color: #94a3b8;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: right;
            }
            ActionButton {
                label: "清除";
                compact: root.compact-width;
                clicked => {
                    root.task-filter-text = "";
                    root.task-market-filter-index = 0;
                    root.task-status-filter-index = 0;
                    root.refresh-data();
                }
            }
        }

        if root.active-page == 0 : VerticalBox {
            spacing: root.compact-height ? 8px : 12px;
            HorizontalBox {
                spacing: root.compact-width ? 6px : 10px;
                StatCard { label: "今日任务"; compact: root.compact-height; value: "" + root.today-count; horizontal-stretch: 1; }
                StatCard { label: "待确认"; compact: root.compact-height; value: "" + root.pending-count; value-color: #fca5a5; horizontal-stretch: 1; }
                StatCard { label: "已确认"; compact: root.compact-height; value: "" + root.acknowledged-count; value-color: #86efac; horizontal-stretch: 1; }
                StatCard { label: "异常数据"; compact: root.compact-height; value: "" + root.issue-count; value-color: #fcd34d; horizontal-stretch: 1; }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                ListView {
                    visible: root.today-tasks.length > 0;
                        for task in root.today-tasks : Rectangle {
                            height: root.compact-width ? (task.warning == "" ? 156px : 184px) : (task.warning == "" ? 132px : 158px);
                            accessible-role: list-item;
                            accessible-label: task.name + "，" + task.market-and-codes + "，" + task.status + "，" + task.quality;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: task.needs-review ? #d97706 : #26334a;
                            background: #0f172a;
                            HorizontalBox {
                                padding: root.compact-width ? 10px : 14px;
                                spacing: root.compact-width ? 8px : 16px;
                                VerticalBox {
                                    width: root.compact-width ? 26% : 29%;
                                    spacing: 5px;
                                    Text { text: task.name; color: #f8fafc; font-size: root.compact-width ? 18px : 20px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: task.market-and-codes; color: #93c5fd; wrap: word-wrap; }
                                    if task.warning != "" : Text { text: task.warning; color: #fbbf24; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalBox {
                                    width: root.compact-width ? 23% : 25%;
                                    spacing: 5px;
                                    Text { text: "申购日 / 安全截止"; color: #94a3b8; font-size: 12px; }
                                    Text { text: task.date-and-cutoff; color: #f8fafc; font-weight: 600; }
                                    Text { text: "发行价 / 上限 / 单位"; color: #94a3b8; font-size: 12px; }
                                    Text { text: task.numbers; color: #e2e8f0; wrap: word-wrap; }
                                }
                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 5px;
                                    Text { text: "官方申购时段"; color: #94a3b8; font-size: 12px; }
                                    Text { text: task.session; color: #e2e8f0; wrap: word-wrap; }
                                    Text { text: task.status + " · " + task.quality; color: task.needs-review ? #fcd34d : #86efac; font-weight: 600; wrap: word-wrap; }
                                    Text { text: task.updated; color: #94a3b8; font-size: 12px; }
                                }
                                VerticalBox {
                                    width: root.compact-width ? 96px : 120px;
                                    spacing: 6px;
                                    ActionButton { label: "查看详情"; compact: root.compact-width; clicked => { root.select-task(task.event-id); } }
                                    if task.can-acknowledge : ActionButton {
                                        label: task.confirm-label;
                                        compact: root.compact-width;
                                        primary: true;
                                        clicked => {
                                            root.confirmation-is-revoke = false;
                                            root.confirmation-event-id = task.event-id;
                                            root.confirmation-event-version = task.event-version;
                                            root.confirmation-title = "二次确认：已经提交申购委托？";
                                            root.confirmation-body = "请确认你已经在券商客户端提交了 " + task.name + " 的申购委托。\n\n本程序不会检查委托是否受理或成功；确认后停止申购日重复提醒，并按已启用设置安排中签、缴款和上市日提示。";
                                            root.show-confirmation = true;
                                        }
                                    }
                                    if task.can-revoke : ActionButton {
                                        label: "撤销确认";
                                        compact: root.compact-width;
                                        danger: true;
                                        clicked => {
                                            root.confirmation-is-revoke = true;
                                            root.confirmation-event-id = task.event-id;
                                            root.confirmation-event-version = task.event-version;
                                            root.confirmation-title = "撤销已申购确认";
                                            root.confirmation-body = "撤销 " + task.name + " 的确认后，程序会立即恢复后续提醒。确定撤销吗？";
                                            root.show-confirmation = true;
                                        }
                                    }
                                }
                            }
                        }
                }
                if root.today-tasks.length == 0 : Text {
                    text: root.today-count == 0
                        ? "今天暂未发现新股申购任务。请同时确认同步状态和数据源健康正常。"
                        : "没有符合当前筛选条件的今日任务。";
                    color: #94a3b8;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.active-page == 1 : Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            border-width: 1px;
            border-color: #26334a;
            background: #111b2e;
            ListView {
                visible: root.future-tasks.length > 0;
                    for task in root.future-tasks : Rectangle {
                        height: root.compact-width ? (task.warning == "" ? 156px : 184px) : (task.warning == "" ? 132px : 158px);
                        accessible-role: list-item;
                        accessible-label: task.name + "，" + task.market-and-codes + "，" + task.status + "，" + task.quality;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: task.needs-review ? #d97706 : #26334a;
                        background: #0f172a;
                        HorizontalBox {
                            padding: root.compact-width ? 10px : 14px;
                            spacing: root.compact-width ? 8px : 16px;
                            VerticalBox {
                                width: root.compact-width ? 27% : 30%;
                                spacing: 5px;
                                Text { text: task.name; color: #f8fafc; font-size: root.compact-width ? 18px : 20px; font-weight: 700; wrap: word-wrap; }
                                Text { text: task.market-and-codes; color: #93c5fd; wrap: word-wrap; }
                                if task.warning != "" : Text { text: task.warning; color: #fbbf24; font-size: 12px; wrap: word-wrap; }
                            }
                            VerticalBox {
                                width: root.compact-width ? 23% : 26%;
                                spacing: 5px;
                                Text { text: "申购日 / 安全截止"; color: #94a3b8; font-size: 12px; }
                                Text { text: task.date-and-cutoff; color: #f8fafc; font-weight: 600; }
                                Text { text: task.numbers; color: #e2e8f0; wrap: word-wrap; }
                            }
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: task.session; color: #e2e8f0; wrap: word-wrap; }
                                Text { text: task.status + " · " + task.quality; color: task.needs-review ? #fcd34d : #86efac; font-weight: 600; wrap: word-wrap; }
                                Text { text: task.updated; color: #94a3b8; font-size: 12px; }
                            }
                            VerticalBox {
                                width: root.compact-width ? 96px : 120px;
                                spacing: 6px;
                                ActionButton { label: "查看详情"; compact: root.compact-width; clicked => { root.select-task(task.event-id); } }
                                if task.can-acknowledge : ActionButton {
                                    label: task.confirm-label;
                                    compact: root.compact-width;
                                    primary: true;
                                    clicked => {
                                        root.confirmation-is-revoke = false;
                                        root.confirmation-event-id = task.event-id;
                                        root.confirmation-event-version = task.event-version;
                                        root.confirmation-title = "二次确认：已经提交申购委托？";
                                        root.confirmation-body = "请确认你已经在券商客户端提交了 " + task.name + " 的申购委托。\n\n本程序不会检查委托是否受理或成功；确认后停止申购日重复提醒，并按已启用设置安排中签、缴款和上市日提示。";
                                        root.show-confirmation = true;
                                    }
                                }
                                if task.can-revoke : ActionButton {
                                    label: "撤销确认";
                                    compact: root.compact-width;
                                    danger: true;
                                    clicked => {
                                        root.confirmation-is-revoke = true;
                                        root.confirmation-event-id = task.event-id;
                                        root.confirmation-event-version = task.event-version;
                                        root.confirmation-title = "撤销已申购确认";
                                        root.confirmation-body = "撤销 " + task.name + " 的确认后，程序会立即恢复后续提醒。确定撤销吗？";
                                        root.show-confirmation = true;
                                    }
                                }
                            }
                        }
                    }
            }
            if root.future-tasks.length == 0 : Text {
                text: root.future-count == 0
                    ? "未来 60 天暂未发现可展示的申购任务。"
                    : "没有符合当前筛选条件的未来任务。";
                color: #94a3b8;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.active-page == 4 : VerticalBox {
            spacing: root.compact-height ? 8px : 12px;
            Rectangle {
                // 用 min-height 而不是固定 height：状态详情和错误文案都会换行，
                // 固定高度在 800px 窄窗或长错误信息下会被裁掉最后一行。
                min-height: root.compact-height ? 86px : 98px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.repo-calendar-warning ? #d97706 : #26334a;
                background: #111b2e;
                VerticalBox {
                    padding: 12px;
                    spacing: 5px;
                    Text { text: root.repo-status; color: #f8fafc; font-size: 19px; font-weight: 700; wrap: word-wrap; }
                    Text { text: root.repo-status-detail; color: #cbd5e1; font-size: 13px; wrap: word-wrap; }
                    if root.repo-error != "" : Text { text: root.repo-error; color: #fca5a5; font-size: 12px; wrap: word-wrap; }
                }
            }
            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                VerticalBox {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "提醒时段"; color: #f8fafc; font-size: 17px; font-weight: 600; }
                    HorizontalBox {
                        spacing: 10px;
                        Toggle { checked <=> root.repo-enabled; label: "启用逆回购提醒"; edited => { root.repo-form-dirty = true; } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "保存设置"; primary: true; clicked => { root.save-repo-settings(root.repo-enabled, root.repo-primary-enabled, root.repo-primary-time, root.repo-fallback-enabled, root.repo-fallback-time); } }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        // Toggle 默认在布局里会拉伸，导致后一个时间输入框被顶到整行最右，
                        // 和它的开关隔出一大段空白；这里固定为最小宽度，让「开关+输入」成对相邻。
                        Toggle { checked <=> root.repo-primary-enabled; label: "14:50 主提醒"; width: 174px; edited => { root.repo-form-dirty = true; } }
                        LineEdit { width: 104px; text <=> root.repo-primary-time; placeholder-text: "14:50"; edited(text) => { root.repo-form-dirty = true; } }
                        Toggle { checked <=> root.repo-fallback-enabled; label: "15:20 兜底"; width: 174px; edited => { root.repo-form-dirty = true; } }
                        LineEdit { width: 104px; text <=> root.repo-fallback-time; placeholder-text: "15:20"; edited(text) => { root.repo-form-dirty = true; } }
                    }
                    Text { text: "只做下午尾盘：13:00–15:25，主提醒和兜底不能相同。14:50 是偏利率的提前提醒，不保证利率更高。"; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                }
            }
            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "操作提示"; color: #f8fafc; font-size: 17px; font-weight: 600; }
                    Text { text: "官方名称：债券通用质押式回购逆回购（俗称国债逆回购）"; color: #e2e8f0; wrap: word-wrap; }
                    Text { text: "沪市 GC001 / 204001，深市 R-001 / 131810；1000 元起。逆回购操作方向为卖出（出借资金）。"; color: #cbd5e1; wrap: word-wrap; }
                    Text { text: "逆回购可交易至 15:30；实际截止以券商客户端为准。"; color: #cbd5e1; wrap: word-wrap; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "交易日历"; color: #f8fafc; font-size: 17px; font-weight: 600; }
                    Text { text: root.repo-calendar-text; color: root.repo-calendar-warning ? #fcd34d : #cbd5e1; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalBox {
                        spacing: 8px;
                        if !root.repo-acked : ActionButton { label: "今日已处理"; primary: true; clicked => { root.set-repo-acked(true); } }
                        if root.repo-acked : ActionButton { label: "撤销今日已处理"; clicked => { root.set-repo-acked(false); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.active-page == 5 : VerticalBox {
            spacing: root.compact-height ? 8px : 10px;
            if !root.credit-form-visible : Rectangle {
                min-height: 58px;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: root.credit-summary; color: #f8fafc; font-size: 18px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    ActionButton {
                        label: "新增还款";
                        compact: root.compact-width;
                        primary: true;
                        clicked => {
                            root.credit-confirm-delete = "";
                            root.credit-confirm-close = "";
                            root.clear-credit-editor();
                            root.credit-form-visible = true;
                            root.preview-credit-form();
                        }
                    }
                }
            }
            if root.credit-form-visible : Rectangle {
                height: root.repayment-page-height;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.credit-form-editing ? #3b82f6 : #26334a;
                background: #111b2e;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    vertical-scrollbar-policy: root.compact-height ? always-on : as-needed;
                    VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.credit-form-editing ? "编辑还款账户" : "新增还款账户"; color: #f8fafc; font-size: 16px; font-weight: 600; }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "类型"; color: #cbd5e1; vertical-alignment: center; }
                        ComboBox {
                            width: 112px;
                            model: ["信用卡", "房贷", "车贷"];
                            current-index <=> root.credit-form-kind-index;
                            enabled: !root.credit-form-editing;
                            selected => { root.preview-credit-form(); }
                        }
                        LineEdit { text <=> root.credit-form-alias; placeholder-text: "别名，例如 招行 Visa / 住房贷款"; horizontal-stretch: 1; edited(text) => { root.credit-form-alias-manual = true; } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { width: 30px; height: 30px; Image { source: root.credit-form-bank-icon; width: 26px; height: 26px; x: 2px; y: 2px; } }
                        ComboBox {
                            width: root.compact-width ? 168px : 204px;
                            model: root.credit-bank-options;
                            current-index <=> root.credit-form-bank-index;
                            selected => { root.preview-credit-form(); }
                        }
                        if root.credit-form-bank-custom : LineEdit {
                            text <=> root.credit-form-bank-name;
                            placeholder-text: "自定义银行名称";
                            horizontal-stretch: 1;
                            edited(text) => { root.preview-credit-form(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "还款日"; color: #cbd5e1; vertical-alignment: center; }
                        ComboBox { width: 86px; model: root.credit-due-day-options; current-index <=> root.credit-form-due-day-index; selected => { root.preview-credit-form(); } }
                        Text { text: "提醒时间"; color: #cbd5e1; vertical-alignment: center; }
                        LineEdit { width: 104px; text <=> root.credit-form-remind-time; placeholder-text: "09:00"; edited(text) => { root.preview-credit-form(); } }
                        Text { text: "提前提醒"; color: #cbd5e1; vertical-alignment: center; }
                        ComboBox {
                            width: root.compact-width ? 204px : 252px;
                            model: ["仅当天", "提前 1 天 + 当天", "提前 3 天 + 当天", "提前 7 天 + 提前 3 天 + 当天", "自定义"];
                            current-index <=> root.credit-form-lead-mode-index;
                            selected => {
                                if (root.credit-form-lead-mode-index == 0) { root.credit-form-lead-days = "0"; }
                                if (root.credit-form-lead-mode-index == 1) { root.credit-form-lead-days = "1,0"; }
                                if (root.credit-form-lead-mode-index == 2) { root.credit-form-lead-days = "3,0"; }
                                if (root.credit-form-lead-mode-index == 3) { root.credit-form-lead-days = "7,3,0"; }
                                root.preview-credit-form();
                            }
                        }
                        if root.credit-form-lead-mode-index == 4 : LineEdit { width: 118px; text <=> root.credit-form-lead-days; placeholder-text: "3,0"; edited(text) => { root.preview-credit-form(); } }
                    }
                    if root.credit-form-kind-index > 0 : HorizontalBox {
                        spacing: 8px;
                        Text { text: "结束还款月（可选）"; color: #cbd5e1; vertical-alignment: center; }
                        LineEdit { width: 118px; text <=> root.credit-form-final-cycle; placeholder-text: "YYYY-MM"; edited(text) => { root.preview-credit-form(); } }
                        Text { text: "包含该月；留空则持续按月提醒。"; color: #94a3b8; font-size: 12px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Toggle { checked <=> root.credit-form-overdue; label: "逾期次日补提醒"; }
                        Toggle { checked <=> root.credit-form-enabled; label: "启用"; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "取消"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.clear-credit-editor(); } }
                        ActionButton {
                            label: "保存";
                            compact: root.compact-width;
                            primary: true;
                            clicked => {
                                root.credit-confirm-delete = "";
                                root.credit-confirm-close = "";
                                root.save-credit-card(root.credit-form-id, root.credit-form-kind-index, root.credit-form-alias, root.credit-form-bank-index, root.credit-form-bank-name, root.credit-form-due-day-index, root.credit-form-remind-time, root.credit-form-lead-mode-index, root.credit-form-lead-days, root.credit-form-final-cycle, root.credit-form-overdue, root.credit-form-enabled);
                            }
                        }
                    }
                    if root.credit-form-preview != "" : Text { text: root.credit-form-preview; color: #93c5fd; font-size: 12px; wrap: word-wrap; }
                    if root.credit-error != "" : Text { text: root.credit-error; color: #fca5a5; font-size: 12px; wrap: word-wrap; }
                    Text { text: "只保存别名、银行和日期；请勿填写贷款金额、利率、完整卡号、安全码或账单金额。29/30/31 日在短月会自动按月末提醒。"; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }
            if !root.credit-form-visible : Rectangle {
                height: root.repayment-page-height - (root.compact-height ? 66px : 68px);
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                ListView {
                    for card in root.credit-cards : Rectangle {
                        // 动作区改为最多三行、每行最多两个按钮，避免贷款新增「已结清」后继续叠加单列高度。
                        height: card.action-rows == 3 ? 172px : 128px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.credit-highlight-id == card.id ? #3b82f6 : card.status-tone >= 2 ? #b45309 : #26334a;
                        background: root.credit-highlight-id == card.id ? #13213c : #0f172a;
                        HorizontalBox {
                            padding-left: root.compact-width ? 8px : 10px;
                            padding-right: root.compact-width ? 18px : 22px;
                            padding-top: root.compact-width ? 8px : 10px;
                            padding-bottom: root.compact-width ? 8px : 10px;
                            spacing: root.compact-width ? 8px : 10px;
                            Rectangle { width: 32px; height: 32px; Image { source: card.bank-icon; width: 28px; height: 28px; x: 2px; y: 2px; } }
                            VerticalBox {
                                width: root.compact-width ? 20% : 24%;
                                spacing: 3px;
                                Text { text: card.alias; color: #f8fafc; font-size: 17px; font-weight: 700; overflow: elide; }
                                Text { text: card.account-kind + " · " + card.bank; color: #94a3b8; font-size: 12px; overflow: elide; }
                            }
                            VerticalBox {
                                width: root.compact-width ? 18% : 21%;
                                spacing: 3px;
                                Text { text: "下次还款"; color: #94a3b8; font-size: 12px; }
                                Text { text: card.due-text; color: #e2e8f0; font-size: 13px; overflow: elide; }
                                Text { text: card.status-text; color: card.status-tone == 3 ? #fca5a5 : card.status-tone == 2 ? #fcd34d : card.status-tone == 1 ? #fbbf24 : #86efac; font-weight: 600; wrap: word-wrap; }
                            }
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: card.lead-text; color: #cbd5e1; font-size: 12px; wrap: word-wrap; }
                                Text { text: card.remind-text; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                if card.final-cycle-text != "" : Text { text: card.final-cycle-text; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                            }
                            Rectangle {
                                width: root.compact-width ? 184px : 216px;
                                VerticalBox {
                                    alignment: start;
                                    spacing: 6px;
                                    if card.can-pay || card.can-undo || card.closed : HorizontalBox {
                                        spacing: 6px;
                                        if card.can-pay : ActionButton { label: "本期已还"; compact: root.compact-width; primary: true; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.mark-credit-paid(card.id, card.cycle-key); } }
                                        if card.can-undo : ActionButton { label: "撤销已还"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.undo-credit-action(card.id); } }
                                        if card.closed : ActionButton { label: "恢复进行中"; compact: root.compact-width; primary: true; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.resume-credit-account(card.id); } }
                                    }
                                    if !card.closed : HorizontalBox {
                                        spacing: 6px;
                                        if root.credit-confirm-delete != card.id : ActionButton { label: "编辑"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.edit-credit-card(card.id); } }
                                        if card.is-loan && root.credit-confirm-delete != card.id && root.credit-confirm-close != card.id : ActionButton { label: "已结清"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = card.id; } }
                                        if !card.is-loan && root.credit-confirm-delete != card.id : ActionButton { label: "删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-close = ""; root.credit-confirm-delete = card.id; } }
                                        if root.credit-confirm-close == card.id : ActionButton { label: "取消"; compact: root.compact-width; clicked => { root.credit-confirm-close = ""; } }
                                        if root.credit-confirm-close == card.id : ActionButton { label: "确定结清"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-close = ""; root.close-credit-account(card.id); } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "取消"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "确定删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-delete = ""; root.delete-credit-card(card.id); } }
                                    }
                                    if card.closed : HorizontalBox {
                                        spacing: 6px;
                                        if root.credit-confirm-delete != card.id : ActionButton { label: "编辑"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; root.credit-confirm-close = ""; root.edit-credit-card(card.id); } }
                                        if root.credit-confirm-delete != card.id : ActionButton { label: "删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-close = ""; root.credit-confirm-delete = card.id; } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "取消"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "确定删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-delete = ""; root.delete-credit-card(card.id); } }
                                    }
                                    if card.is-loan && !card.closed : HorizontalBox {
                                        spacing: 6px;
                                        if root.credit-confirm-delete != card.id : ActionButton { label: "删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-close = ""; root.credit-confirm-delete = card.id; } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "取消"; compact: root.compact-width; clicked => { root.credit-confirm-delete = ""; } }
                                        if root.credit-confirm-delete == card.id : ActionButton { label: "确定删除"; compact: root.compact-width; danger: true; clicked => { root.credit-confirm-delete = ""; root.delete-credit-card(card.id); } }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.credit-cards.length == 0 : Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "还没有还款提醒。添加信用卡、房贷或车贷后，程序只记录别名、银行和日期。";
                    color: #94a3b8;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.active-page == 2 : VerticalBox {
            spacing: root.compact-height ? 8px : 12px;
            Rectangle {
                height: root.compact-height ? 110px : 124px;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                HorizontalBox {
                    padding-left: root.compact-width ? 10px : 14px;
                    padding-right: root.compact-width ? 10px : 14px;
                    padding-top: root.compact-height ? 10px : 14px;
                    padding-bottom: root.compact-height ? 10px : 14px;
                    spacing: root.compact-width ? 8px : 12px;
                    VerticalBox {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: root.health-title; color: root.runtime-level == 2 ? #fca5a5 : root.runtime-level == 1 ? #86efac : #fcd34d; font-size: root.compact-width ? 19px : 21px; font-weight: 700; }
                        Text { text: root.health-summary; color: #e2e8f0; wrap: word-wrap; }
                        Text { text: root.heartbeat-text; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.clock-text; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                    }
                    ActionButton { label: "刷新诊断"; compact: root.compact-width; clicked => { root.refresh-data(); } }
                }
            }
            Text { text: "数据源"; color: #f8fafc; font-size: 18px; font-weight: 600; }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                ScrollView {
                    VerticalBox {
                        horizontal-stretch: 1;
                        padding: 10px;
                        spacing: 8px;
                        for source in root.source-health : Rectangle {
                            height: root.compact-width ? (source.error-text == "" ? 68px : 90px) : (source.error-text == "" ? 62px : 80px);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: source.state-level == 1 ? #26334a : #d97706;
                            background: #0f172a;
                            VerticalBox {
                                padding: 10px;
                                spacing: 3px;
                                HorizontalBox {
                                    spacing: root.compact-width ? 8px : 12px;
                                    Text { text: source.source; color: #f8fafc; font-weight: 600; width: root.compact-width ? 140px : 180px; wrap: word-wrap; }
                                    Text { text: source.state; color: source.state-level == 1 ? #86efac : source.state-level == 2 ? #fcd34d : #fca5a5; width: root.compact-width ? 90px : 110px; wrap: word-wrap; }
                                    Text { text: source.record-text; color: #94a3b8; width: root.compact-width ? 100px : 120px; wrap: word-wrap; }
                                    Text { text: source.last-success-text; color: #94a3b8; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                                if source.error-text != "" : Text { text: source.error-text; color: #fca5a5; font-size: 12px; overflow: elide; }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: root.compact-height ? 100px : 104px;
                border-radius: 10px;
                border-width: 1px;
                border-color: #26334a;
                background: #111b2e;
                VerticalBox {
                    padding-left: root.compact-width ? 10px : 12px;
                    padding-right: root.compact-width ? 10px : 12px;
                    padding-top: root.compact-height ? 10px : 12px;
                    padding-bottom: root.compact-height ? 10px : 12px;
                    spacing: root.compact-height ? 5px : 7px;
                    Text { text: "本地诊断"; color: #f8fafc; font-size: 17px; font-weight: 600; }
                    Text { text: root.data-root-text; color: #94a3b8; font-size: 12px; overflow: elide; }
                    HorizontalBox {
                        spacing: root.compact-width ? 6px : 8px;
                        ActionButton { label: "打开数据目录"; compact: root.compact-width; clicked => { root.open-data-folder(); } }
                        ActionButton { label: "复制诊断摘要"; compact: root.compact-width; clicked => { root.copy-diagnostics(); } }
                        ActionButton { label: "导出脱敏诊断包"; compact: root.compact-width; clicked => { root.create-diagnostics(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.active-page == 3 : Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            border-width: 1px;
            border-color: #26334a;
            background: #111b2e;
            VerticalBox {
                padding-left: root.compact-width ? 10px : 14px;
                padding-right: root.compact-width ? 10px : 14px;
                padding-top: root.compact-height ? 10px : 14px;
                padding-bottom: root.compact-height ? 10px : 14px;
                spacing: root.compact-height ? 8px : 10px;
                if !root.onboarding-completed : Rectangle {
                    min-height: root.compact-width ? 74px : 58px;
                    max-height: root.compact-width ? 74px : 58px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #d97706;
                    background: #3a2510;
                    HorizontalBox {
                        padding: 10px;
                        spacing: 10px;
                        Text {
                            text: "首次使用请确认市场、券商受理时间和安全截止时间，并完成一次提醒通道测试。";
                            color: #fcd34d;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        ActionButton {
                            label: "去完成测试";
                            compact: root.compact-width;
                            clicked => { root.settings-section = 1; }
                        }
                    }
                }
                HorizontalBox {
                    spacing: root.compact-width ? 6px : 8px;
                    SettingsTab { label: "常用"; selected: root.settings-section == 0; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.settings-section = 0; } }
                    SettingsTab { label: "通知与测试"; selected: root.settings-section == 1; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.settings-section = 1; } }
                    SettingsTab { label: "同步"; selected: root.settings-section == 2; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.settings-section = 2; } }
                    SettingsTab { label: "高级与维护"; selected: root.settings-section == 3; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.settings-section = 3; } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    ScrollView {
                        VerticalBox {
                            horizontal-stretch: 1;
                            padding: 1px;
                            spacing: root.compact-height ? 8px : 10px;
                            if root.settings-section == 0 : VerticalBox {
                                spacing: root.compact-height ? 8px : 10px;
                                if !root.compact-width : HorizontalBox {
                                    spacing: 10px;
                                    Rectangle {
                                        min-height: 152px;
                                        max-height: 152px;
                                        horizontal-stretch: 1;
                                        border-radius: 9px;
                                        border-width: 1px;
                                        border-color: #26334a;
                                        background: #0f172a;
                                        VerticalBox {
                                            padding: 12px;
                                            spacing: 8px;
                                            Text { text: "启用市场"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                            HorizontalBox {
                                                spacing: 8px;
                                                Toggle { label: "沪市主板 / 科创板"; checked <=> root.shanghai-enabled; horizontal-stretch: 1; }
                                                Toggle { label: "深市主板 / 创业板"; checked <=> root.shenzhen-enabled; horizontal-stretch: 1; }
                                                Toggle { label: "北交所"; checked <=> root.beijing-enabled; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        min-height: 152px;
                                        max-height: 152px;
                                        horizontal-stretch: 1;
                                        border-radius: 9px;
                                        border-width: 1px;
                                        border-color: #26334a;
                                        background: #0f172a;
                                        VerticalBox {
                                            padding: 12px;
                                            spacing: 8px;
                                            Text { text: "后续提醒与启动"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                            HorizontalBox {
                                                spacing: 8px;
                                                Toggle { label: "交易时段健康摘要"; checked <=> root.health-summary-enabled; horizontal-stretch: 1; }
                                                Toggle { label: "中签与缴款提醒"; checked <=> root.post-apply-reminders-enabled; horizontal-stretch: 1; }
                                            }
                                            HorizontalBox {
                                                spacing: 8px;
                                                Toggle { label: "上市日提醒"; checked <=> root.listing-reminders-enabled; horizontal-stretch: 1; }
                                                Toggle { label: "开机自动启动"; checked <=> root.auto-start; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                                if root.compact-width : Rectangle {
                                    min-height: 184px;
                                    max-height: 184px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "启用市场"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Toggle { label: "沪市主板 / 科创板"; checked <=> root.shanghai-enabled; }
                                        Toggle { label: "深市主板 / 创业板"; checked <=> root.shenzhen-enabled; }
                                        Toggle { label: "北交所"; checked <=> root.beijing-enabled; }
                                    }
                                }
                                if root.compact-width : Rectangle {
                                    min-height: 216px;
                                    max-height: 216px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "后续提醒与启动"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Toggle { label: "交易时段健康摘要"; checked <=> root.health-summary-enabled; }
                                        Toggle { label: "中签与缴款提醒"; checked <=> root.post-apply-reminders-enabled; }
                                        Toggle { label: "上市日提醒"; checked <=> root.listing-reminders-enabled; }
                                        Toggle { label: "开机自动启动"; checked <=> root.auto-start; }
                                    }
                                }
                                Rectangle {
                                    min-height: root.compact-width ? 264px : 188px;
                                    max-height: root.compact-width ? 264px : 188px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "券商受理与安全截止"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: "时间格式 HH:mm。安全截止应在 13:00–15:00，建议保留几分钟券商处理余量。"; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                        if !root.compact-width : HorizontalBox {
                                            spacing: 12px;
                                            LabeledInput { label: "沪市券商受理开始"; value <=> root.shanghai-start; horizontal-stretch: 1; }
                                            LabeledInput { label: "深市券商受理开始"; value <=> root.shenzhen-start; horizontal-stretch: 1; }
                                            LabeledInput { label: "北交所券商受理开始"; value <=> root.beijing-start; horizontal-stretch: 1; }
                                            LabeledInput { label: "安全截止时间"; value <=> root.safety-cutoff; horizontal-stretch: 1; }
                                        }
                                        if root.compact-width : VerticalBox {
                                            spacing: 8px;
                                            HorizontalBox {
                                                spacing: 10px;
                                                LabeledInput { label: "沪市券商受理开始"; value <=> root.shanghai-start; horizontal-stretch: 1; }
                                                LabeledInput { label: "深市券商受理开始"; value <=> root.shenzhen-start; horizontal-stretch: 1; }
                                            }
                                            HorizontalBox {
                                                spacing: 10px;
                                                LabeledInput { label: "北交所券商受理开始"; value <=> root.beijing-start; horizontal-stretch: 1; }
                                                LabeledInput { label: "安全截止时间"; value <=> root.safety-cutoff; horizontal-stretch: 1; }
                                            }
                                        }
                                        Toggle { label: "我的券商支持北交所开盘前预约申购"; checked <=> root.beijing-reservation; }
                                    }
                                }
                            }
                            if root.settings-section == 1 : VerticalBox {
                                spacing: root.compact-height ? 8px : 10px;
                                Rectangle {
                                    min-height: root.compact-width ? 184px : 116px;
                                    max-height: root.compact-width ? 184px : 116px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "提醒呈现"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        if !root.compact-width : HorizontalBox {
                                            spacing: 8px;
                                            Toggle { label: "声音"; checked <=> root.sound-enabled; horizontal-stretch: 1; }
                                            Toggle { label: "系统通知（Toast，失败时回退气泡）"; checked <=> root.toast-enabled; horizontal-stretch: 1; }
                                        }
                                        if root.compact-width : VerticalBox {
                                            spacing: 8px;
                                            Toggle { label: "声音"; checked <=> root.sound-enabled; }
                                            Toggle { label: "系统通知（Toast，失败时回退气泡）"; checked <=> root.toast-enabled; }
                                        }
                                    }
                                }
                                Rectangle {
                                    min-height: root.compact-width ? 320px : 236px;
                                    max-height: root.compact-width ? 320px : 236px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "测试提醒通道"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text {
                                            text: root.notification-platform-status;
                                            color: root.notification-platform-level == 1 ? #86efac : root.notification-platform-level == 2 ? #fca5a5 : #fcd34d;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        if !root.compact-width : HorizontalBox {
                                            spacing: 10px;
                                            NotificationTestItem { label: "测试置顶提醒窗"; status: root.notification-window-test-status; level: root.notification-window-test-level; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.test-notification-channel(0); } }
                                            NotificationTestItem { label: "测试 Windows Toast"; status: root.notification-toast-test-status; level: root.notification-toast-test-level; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.test-notification-channel(1); } }
                                        }
                                        if !root.compact-width : HorizontalBox {
                                            spacing: 10px;
                                            NotificationTestItem { label: "测试气泡回退"; status: root.notification-balloon-test-status; level: root.notification-balloon-test-level; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.test-notification-channel(2); } }
                                            NotificationTestItem { label: "测试声音"; status: root.notification-sound-test-status; level: root.notification-sound-test-level; compact: root.compact-width; horizontal-stretch: 1; clicked => { root.test-notification-channel(3); } }
                                        }
                                        if root.compact-width : VerticalBox {
                                            spacing: 8px;
                                            NotificationTestItem { label: "测试置顶提醒窗"; status: root.notification-window-test-status; level: root.notification-window-test-level; compact: root.compact-width; clicked => { root.test-notification-channel(0); } }
                                            NotificationTestItem { label: "测试 Windows Toast"; status: root.notification-toast-test-status; level: root.notification-toast-test-level; compact: root.compact-width; clicked => { root.test-notification-channel(1); } }
                                            NotificationTestItem { label: "测试气泡回退"; status: root.notification-balloon-test-status; level: root.notification-balloon-test-level; compact: root.compact-width; clicked => { root.test-notification-channel(2); } }
                                            NotificationTestItem { label: "测试声音"; status: root.notification-sound-test-status; level: root.notification-sound-test-level; compact: root.compact-width; clicked => { root.test-notification-channel(3); } }
                                        }
                                        Text { text: "Windows Toast 与气泡回退任一通过，即可满足系统通知测试。"; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                        Text { text: root.notification-test-status; color: root.notification-test-completed ? #86efac : #fcd34d; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                            if root.settings-section == 2 : Rectangle {
                                min-height: 200px;
                                max-height: 200px;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #26334a;
                                background: #0f172a;
                                VerticalBox {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text { text: "节能同步"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                    Text { text: "健康且没有待确认任务时，每个工作日最多进行一次发现同步；下方间隔只用于异常重试和当日未确认任务核验。"; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                    HorizontalBox {
                                        height: 34px;
                                        spacing: 10px;
                                        Text { width: root.compact-width ? 150px : 190px; text: "来源异常重试"; color: #cbd5e1; vertical-alignment: center; }
                                        LineEdit { width: 110px; text <=> root.normal-sync-interval-value; placeholder-text: "30"; }
                                        ComboBox { width: 110px; model: ["分钟", "小时"]; current-index <=> root.normal-sync-interval-unit-index; }
                                        Text { text: "默认 30 分钟"; color: #64748b; font-size: 12px; vertical-alignment: center; }
                                    }
                                    HorizontalBox {
                                        height: 34px;
                                        spacing: 10px;
                                        Text { width: root.compact-width ? 150px : 190px; text: "当日未确认任务核验"; color: #cbd5e1; vertical-alignment: center; }
                                        LineEdit { width: 110px; text <=> root.active-sync-interval-value; placeholder-text: "20"; }
                                        ComboBox { width: 110px; model: ["分钟", "小时"]; current-index <=> root.active-sync-interval-unit-index; }
                                        Text { text: "默认 20 分钟，不得大于来源异常重试间隔"; color: #64748b; font-size: 12px; vertical-alignment: center; }
                                    }
                                    Text { text: "任务已确认、没有真实提醒或处于周末时，程序会按需休眠到下一次必要唤醒；手动同步不受自动同步窗口限制。"; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                            if root.settings-section == 3 : VerticalBox {
                                spacing: root.compact-height ? 8px : 10px;
                                Text { text: "通知与自动化"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                Rectangle {
                                    min-height: root.secondary-notification-provider-index == 0 ? (root.compact-width ? 238px : 210px) : (root.compact-width ? 348px : 292px);
                                    max-height: root.secondary-notification-provider-index == 0 ? (root.compact-width ? 238px : 210px) : (root.compact-width ? 348px : 292px);
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "第二通知通道"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: root.secondary-notification-status; color: root.secondary-notification-configured ? #86efac : #94a3b8; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            ComboBox { width: root.compact-width ? 170px : 200px; model: ["不启用", "企业微信机器人", "钉钉机器人", "飞书机器人", "PushPlus"]; current-index <=> root.secondary-notification-provider-index; }
                                            Text { text: root.secondary-notification-provider-index == 0 ? "选择服务商后可启用第二通知" : "选择服务商后可填写或保留加密凭据"; color: #94a3b8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                        }
                                        if root.secondary-notification-provider-index > 0 : HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Toggle { label: "同时发送到第二通道"; checked <=> root.secondary-notification-enabled; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.secondary-notification-configured : ActionButton { label: root.secondary-notification-busy ? "正在测试…" : "发送测试"; compact: root.compact-width; primary: true; enabled: !root.secondary-notification-busy; clicked => { root.test-secondary-notification(); } }
                                            if root.secondary-notification-configured : ActionButton { label: "清除凭据"; compact: root.compact-width; danger: true; enabled: !root.secondary-notification-busy; clicked => { root.clear-secondary-notification-secret(); } }
                                        }
                                        if root.secondary-notification-provider-index > 0 : LineEdit { text <=> root.secondary-notification-secret-entry; input-type: InputType.password; placeholder-text: root.secondary-notification-provider-index == 4 ? "输入 PushPlus token；留空表示保留已加密凭据" : "输入官方机器人 Webhook URL；留空表示保留已加密凭据"; enabled: root.secondary-notification-provider-index > 0; }
                                        Text { text: "仅允许企业微信、钉钉、飞书官方 HTTPS Webhook 或 PushPlus token。凭据由 Windows DPAPI 绑定当前用户加密，不写入数据库、日志、诊断 ZIP 或命令行。发送请求禁止重定向，最多重试 5 次，并限制为每小时 20 个批次。"; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                Rectangle {
                                    min-height: root.compact-width ? 330px : 276px;
                                    max-height: root.compact-width ? 330px : 276px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "安全自动更新"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: "当前版本 " + root.app-version + (root.update-version == "" ? "" : "　可用版本 " + root.update-version); color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                        Text { text: root.update-status; color: root.update-ready || root.update-available ? #86efac : root.update-configured ? #cbd5e1 : #94a3b8; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                        HorizontalBox {
                                            spacing: 10px;
                                            Toggle { label: "自动检查稳定版更新（启动时及每 6 小时）"; checked <=> root.automatic-updates-enabled; enabled: root.update-configured; }
                                            Rectangle { horizontal-stretch: 1; }
                                            ActionButton { label: "检查更新"; compact: root.compact-width; enabled: root.update-configured && !root.update-downloading; clicked => { root.check-for-updates(); } }
                                            if root.update-available || root.update-ready : UpdatePill { label: root.update-downloading ? "下载中 " + root.update-download-progress + "%" : root.update-download-failed ? "重试" : "更新到 " + root.update-version; enabled: !root.update-downloading; clicked => { root.request-update(); } }
                                        }
                                        HorizontalBox {
                                            spacing: 10px;
                                            Toggle { label: "发现更新后提前下载（默认关闭）"; checked <=> root.automatic-update-download-enabled; enabled: root.update-configured; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.update-release-notes-url != "" : ActionButton { label: "发布说明"; compact: root.compact-width; clicked => { root.open-release-notes(); } }
                                        }
                                        Text { text: "更新清单由内置 Minisign 公钥验证，安装前复核大小和 SHA-256。标题行版本号旁的绿色按钮一次点击即完成下载、安装并重启到托盘；未购买代码签名证书时，Windows 可能显示“未知发布者”与 UAC 确认，属正常安全提示。"; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                Rectangle {
                                    min-height: 172px;
                                    max-height: 172px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "脱敏崩溃报告"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: root.crash-upload-status; color: root.crash-upload-configured ? #cbd5e1 : #94a3b8; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                        HorizontalBox {
                                            spacing: 10px;
                                            Toggle { label: "异常退出后自动发送下一份报告"; checked <=> root.crash-upload-enabled; enabled: root.crash-upload-configured; }
                                            Rectangle { horizontal-stretch: 1; }
                                            ActionButton { label: root.crash-upload-busy ? "正在发送…" : "发送最近报告"; compact: root.compact-width; primary: true; enabled: root.crash-upload-configured && !root.crash-upload-busy; clicked => { root.upload-crash-report(); } }
                                            ActionButton { label: "隐私政策"; compact: root.compact-width; enabled: root.crash-upload-configured; clicked => { root.open-crash-upload-privacy(); } }
                                        }
                                        Text { text: "仅发送 Watchdog 生成的 JSON；不发送数据库、日志、公告正文、命令行、路径、用户名、设备标识、账户、持仓或凭据。过去 24 小时最多尝试 3 次。"; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                Text { text: "本地维护"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                Rectangle {
                                    min-height: root.compact-width ? 148px : 126px;
                                    max-height: root.compact-width ? 148px : 126px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #26334a;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "本地缓存与数据"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: root.data-root-text; color: #94a3b8; font-size: 12px; overflow: elide; }
                                        HorizontalBox {
                                            spacing: 10px;
                                            ActionButton { label: "打开本地缓存目录"; compact: root.compact-width; clicked => { root.open-data-folder(); } }
                                            Text { text: "包含数据库、公告 PDF、日志、备份和诊断文件；打开目录不会清理或修改数据。"; color: #64748b; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                        }
                                    }
                                }
                                Rectangle {
                                    min-height: 126px;
                                    max-height: 126px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: #7f1d1d;
                                    background: #0f172a;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "安装与卸载"; color: #f8fafc; font-size: 18px; font-weight: 600; }
                                        Text { text: root.uninstall-status; color: root.uninstall-available ? #cbd5e1 : #94a3b8; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                        HorizontalBox {
                                            spacing: 10px;
                                            Text { text: "默认卸载只移除程序并保留数据库、设置、公告缓存和备份。"; color: #94a3b8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                            ActionButton {
                                                label: "卸载程序";
                                                compact: root.compact-width;
                                                danger: true;
                                                enabled: root.uninstall-available;
                                                clicked => {
                                                    root.uninstall-purge-data = false;
                                                    root.uninstall-confirmation-text = "";
                                                    root.show-uninstall-confirmation = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalBox {
                    min-height: 38px;
                    max-height: 38px;
                    spacing: 8px;
                    Text {
                        text: root.reset-settings-pending ? "已恢复默认值，点击保存后才会生效。" : "切换设置分区不会丢失未保存的修改。";
                        color: root.reset-settings-pending ? #fcd34d : #94a3b8;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    ActionButton { label: "恢复默认"; compact: root.compact-width; clicked => { root.reset-settings(); } }
                    ActionButton { label: "保存设置"; compact: root.compact-width; primary: true; clicked => { root.save-settings(); } }
                    ActionButton {
                        label: "安全退出";
                        compact: root.compact-width;
                        danger: true;
                        clicked => {
                            if (root.pending-count > 0) {
                                root.show-exit-confirmation = true;
                            } else {
                                root.exit-app();
                            }
                        }
                    }
                }
            }
        }

        if !root.compact-height : Text {
            text: "本程序只记录你的人工确认，不连接券商、不自动下单，也无法验证券商委托是否成功。";
            color: #94a3b8;
            font-size: 12px;
        }
    }

    if root.show-details : Rectangle {
        background: #aa020617;
        Rectangle {
            width: parent.width > 1040px ? 960px : parent.width - (root.compact-width ? 24px : 40px);
            height: parent.height > 720px ? 680px : parent.height - (root.compact-height ? 16px : 30px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: #3b82f6;
            background: #111b2e;
            VerticalBox {
                padding-left: root.compact-width ? 12px : 18px;
                padding-right: root.compact-width ? 12px : 18px;
                padding-top: root.compact-height ? 12px : 18px;
                padding-bottom: root.compact-height ? 12px : 18px;
                spacing: root.compact-height ? 8px : 10px;
                HorizontalBox {
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: root.selected-title; color: #f8fafc; font-size: root.compact-width ? 20px : 22px; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.selected-summary; color: #93c5fd; font-size: 12px; wrap: word-wrap; }
                        if root.selected-warning != "" : Text { text: root.selected-warning; color: #fcd34d; font-size: 12px; wrap: word-wrap; }
                    }
                    Rectangle {
                        width: root.compact-width ? 110px : 126px;
                        height: 34px;
                        border-radius: 7px;
                        background: root.selected-quality-alert ? #9a3412 : #166534;
                        Text { text: root.selected-quality; color: white; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    ActionButton { label: "关闭"; compact: root.compact-width; clicked => { root.show-details = false; } }
                }
                HorizontalBox {
                    height: root.compact-width ? 38px : 40px;
                    spacing: 6px;
                    NavButton { label: "任务摘要"; compact: root.compact-width; selected: root.details-active-tab == 0; clicked => { root.details-active-tab = 0; } }
                    NavButton { label: "字段来源"; compact: root.compact-width; selected: root.details-active-tab == 1; clicked => { root.details-active-tab = 1; } }
                    NavButton { label: "正式公告"; compact: root.compact-width; selected: root.details-active-tab == 2; clicked => { root.details-active-tab = 2; } }
                    NavButton { label: "人工核验与覆盖"; compact: root.compact-width; selected: root.details-active-tab == 3; clicked => { root.details-active-tab = 3; } }
                }

                if root.details-active-tab == 0 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: #0f172a;
                    ScrollView { Text { text: root.selected-detail; color: #cbd5e1; wrap: word-wrap; x: 12px; y: 12px; width: parent.width - 24px; } }
                }

                if root.details-active-tab == 1 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: #0f172a;
                    ScrollView {
                        VerticalBox {
                            padding: 10px;
                            spacing: 7px;
                            if root.field-source-rows.length == 0 : Text { text: "尚无可显示的字段来源记录。"; color: #94a3b8; horizontal-alignment: center; height: 300px; vertical-alignment: center; }
                            for source in root.field-source-rows : Rectangle {
                                height: root.compact-width ? 86px : 70px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #26334a;
                                background: #111b2e;
                                HorizontalBox {
                                    padding: root.compact-width ? 8px : 10px;
                                    spacing: root.compact-width ? 8px : 12px;
                                    Text { text: source.field-name; color: #f8fafc; font-weight: 600; width: root.compact-width ? 86px : 112px; wrap: word-wrap; }
                                    Text { text: source.normalized-value; color: #e2e8f0; width: root.compact-width ? 118px : 155px; wrap: word-wrap; }
                                    Text { text: source.source-text; color: #93c5fd; width: root.compact-width ? 132px : 170px; wrap: word-wrap; }
                                    Text { text: source.fetched-text; color: #94a3b8; width: root.compact-width ? 105px : 140px; wrap: word-wrap; }
                                    Text { text: source.raw-value; color: #cbd5e1; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }

                if root.details-active-tab == 2 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: #0f172a;
                    ScrollView {
                        VerticalBox {
                            padding: 10px;
                            spacing: 8px;
                            if root.announcement-rows.length == 0 : Text { text: "尚未检索到相关正式公告链接；任务仍会保留并继续提醒。"; color: #94a3b8; horizontal-alignment: center; height: 300px; vertical-alignment: center; wrap: word-wrap; }
                            for announcement in root.announcement-rows : Rectangle {
                                height: 112px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #26334a;
                                background: #111b2e;
                                HorizontalBox {
                                    padding: 11px;
                                    spacing: 12px;
                                    VerticalBox {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: announcement.title; color: #f8fafc; font-weight: 600; wrap: word-wrap; }
                                        Text { text: announcement.metadata; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                        Text { text: announcement.evidence; color: #cbd5e1; font-size: 12px; wrap: word-wrap; }
                                    }
                                    VerticalBox {
                                        width: root.compact-width ? 96px : 120px;
                                        spacing: 7px;
                                        ActionButton { label: "打开原文"; compact: root.compact-width; clicked => { root.open-external(announcement.source-url); } }
                                        ActionButton { label: "打开历史本地文件"; compact: root.compact-width; enabled: announcement.local-available; clicked => { root.open-local(announcement.local-path); } }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.details-active-tab == 3 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: #0f172a;
                    ScrollView {
                        VerticalBox {
                            padding-left: root.compact-width ? 9px : 12px;
                            padding-right: root.compact-width ? 9px : 12px;
                            padding-top: root.compact-height ? 9px : 12px;
                            padding-bottom: root.compact-height ? 9px : 12px;
                            spacing: root.compact-height ? 8px : 9px;
                            Rectangle {
                                height: root.compact-width ? 76px : 60px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #d97706;
                                background: #3a2510;
                                Text { text: "仅在核对正式公告后使用。人工覆盖会记录字段、值、理由、依据公告和当前发行版本；外部关键数据形成新版本后不会沿用旧覆盖。"; color: #fcd34d; wrap: word-wrap; x: 10px; width: parent.width - 20px; vertical-alignment: center; }
                            }
                            if !root.compact-width : HorizontalBox {
                                spacing: 8px;
                                VerticalBox {
                                    spacing: 4px;
                                    width: 210px;
                                    Text { text: "覆盖字段"; color: #94a3b8; font-size: 12px; }
                                    ComboBox {
                                        model: ["申购代码", "申购日期", "发行价格", "申购上限（股）", "申购单位（股）", "官方申购时段", "发行状态"];
                                        current-index <=> root.override-field-index;
                                    }
                                }
                                LabeledInput { label: "覆盖值"; value <=> root.override-value; horizontal-stretch: 1; }
                                LabeledInput { label: "核验理由"; value <=> root.override-reason; horizontal-stretch: 1; }
                                VerticalBox {
                                    spacing: 4px;
                                    width: 250px;
                                    Text { text: "依据公告（可选）"; color: #94a3b8; font-size: 12px; }
                                    ComboBox { model: root.announcement-choices; current-index <=> root.override-announcement-index; }
                                }
                            }
                            if root.compact-width : VerticalBox {
                                spacing: 8px;
                                HorizontalBox {
                                    spacing: 8px;
                                    VerticalBox {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text { text: "覆盖字段"; color: #94a3b8; font-size: 12px; }
                                        ComboBox {
                                            model: ["申购代码", "申购日期", "发行价格", "申购上限（股）", "申购单位（股）", "官方申购时段", "发行状态"];
                                            current-index <=> root.override-field-index;
                                        }
                                    }
                                    VerticalBox {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text { text: "依据公告（可选）"; color: #94a3b8; font-size: 12px; }
                                        ComboBox { model: root.announcement-choices; current-index <=> root.override-announcement-index; }
                                    }
                                }
                                HorizontalBox {
                                    spacing: 8px;
                                    LabeledInput { label: "覆盖值"; value <=> root.override-value; horizontal-stretch: 1; }
                                    LabeledInput { label: "核验理由"; value <=> root.override-reason; horizontal-stretch: 1; }
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                Text { text: root.override-status; color: #94a3b8; horizontal-stretch: 1; wrap: word-wrap; }
                                ActionButton {
                                    label: "保存人工覆盖";
                                    compact: root.compact-width;
                                    primary: true;
                                    enabled: root.selected-event-id != "" && root.override-value != "" && root.override-reason != "";
                                    clicked => {
                                        root.override-confirmation-is-revoke = false;
                                        root.override-confirmation-title = "确认人工覆盖";
                                        root.override-confirmation-body = "确定保存当前人工核验值吗？此操作会记录审计信息，并重算后续提醒。";
                                        root.show-override-confirmation = true;
                                    }
                                }
                            }
                            Text { text: "当前版本的人工覆盖记录"; color: #f8fafc; font-size: 16px; font-weight: 600; }
                            if root.override-rows.length == 0 : Text { text: "当前版本尚无人工覆盖记录。"; color: #94a3b8; }
                            for entry in root.override-rows : Rectangle {
                                height: root.compact-width ? 88px : 76px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #26334a;
                                background: #111b2e;
                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;
                                    VerticalBox {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: entry.summary; color: #f8fafc; font-weight: 600; wrap: word-wrap; }
                                        Text { text: entry.metadata; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                    }
                                    ActionButton {
                                        label: "撤销覆盖";
                                        compact: root.compact-width;
                                        danger: true;
                                        enabled: entry.can-revoke;
                                        clicked => {
                                            root.override-confirmation-is-revoke = true;
                                            root.override-confirmation-id = entry.id;
                                            root.override-confirmation-title = "撤销人工覆盖";
                                            root.override-confirmation-body = "确定撤销这条人工覆盖吗？撤销后将恢复公开来源值并重算提醒。";
                                            root.show-override-confirmation = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-override-confirmation : Rectangle {
        background: #b0020617;
        Rectangle {
            width: 560px;
            height: 250px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.override-confirmation-is-revoke ? #dc2626 : #f59e0b;
            background: #111b2e;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: root.override-confirmation-title; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text { text: root.override-confirmation-body; color: #cbd5e1; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "取消"; clicked => { root.show-override-confirmation = false; } }
                    ActionButton {
                        label: root.override-confirmation-is-revoke ? "确定撤销" : "确定保存";
                        primary: !root.override-confirmation-is-revoke;
                        danger: root.override-confirmation-is-revoke;
                        clicked => {
                            if (root.override-confirmation-is-revoke) {
                                root.revoke-override(root.selected-event-id, root.selected-event-version, root.override-confirmation-id);
                            } else {
                                root.apply-override(root.selected-event-id, root.selected-event-version, root.override-field-index, root.override-value, root.override-reason, root.override-announcement-index);
                            }
                            root.show-override-confirmation = false;
                        }
                    }
                }
            }
        }
    }

    if root.show-confirmation : Rectangle {
        background: #b0020617;
        Rectangle {
            width: 560px;
            height: 280px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.confirmation-is-revoke ? #dc2626 : #f59e0b;
            background: #111b2e;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: root.confirmation-title; color: #f8fafc; font-size: 21px; font-weight: 700; wrap: word-wrap; }
                Text { text: root.confirmation-body; color: #cbd5e1; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "取消"; clicked => { root.show-confirmation = false; } }
                    ActionButton {
                        label: root.confirmation-is-revoke ? "确定撤销" : "确认已申购";
                        primary: !root.confirmation-is-revoke;
                        danger: root.confirmation-is-revoke;
                        clicked => {
                            if (root.confirmation-is-revoke) {
                                root.revoke-acknowledgement(root.confirmation-event-id, root.confirmation-event-version);
                            } else {
                                root.acknowledge(root.confirmation-event-id, root.confirmation-event-version);
                            }
                            root.show-confirmation = false;
                        }
                    }
                }
            }
        }
    }

    if root.show-reminder : Rectangle {
        background: #b0020617;
        Rectangle {
            width: 620px;
            height: 320px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 2px;
            border-color: #e7a52d;
            background: #3a2510;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: root.reminder-title; color: #fcd34d; font-size: 24px; font-weight: 700; wrap: word-wrap; }
                Text { text: root.reminder-body; color: #f8fafc; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        label: "打开详情";
                        enabled: root.reminder-event-id != "";
                        clicked => {
                            root.show-reminder = false;
                            root.select-task(root.reminder-event-id);
                        }
                    }
                    ActionButton {
                        label: "确认已申购";
                        primary: true;
                        enabled: root.reminder-event-id != "";
                        clicked => {
                            root.confirmation-is-revoke = false;
                            root.confirmation-event-id = root.reminder-event-id;
                            root.confirmation-event-version = root.reminder-event-version;
                            root.confirmation-title = "二次确认：已经提交申购委托？";
                            root.confirmation-body = "请确认已经在券商客户端提交申购委托。本程序不会检查委托是否受理或成功；确认后停止申购日重复提醒，并按已启用设置安排中签、缴款和上市日提示。";
                            root.show-reminder = false;
                            root.show-confirmation = true;
                        }
                    }
                    ActionButton { label: "稍后处理"; clicked => { root.show-reminder = false; } }
                }
            }
        }
    }

    if root.show-notification-confirmation : Rectangle {
        background: #b0020617;
        Rectangle {
            width: 560px;
            height: 250px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: #3b82f6;
            background: #111b2e;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: root.notification-test-title; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text { text: root.notification-test-question; color: #cbd5e1; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "未观察到"; danger: true; clicked => { root.complete-notification-test(root.notification-test-channel, false); root.show-notification-confirmation = false; } }
                    ActionButton { label: "已观察到"; primary: true; clicked => { root.complete-notification-test(root.notification-test-channel, true); root.show-notification-confirmation = false; } }
                }
            }
        }
    }

    if root.show-uninstall-confirmation : Rectangle {
        background: #c0020617;
        Rectangle {
            width: 620px;
            height: root.uninstall-purge-data ? 390px : 310px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 2px;
            border-color: #dc2626;
            background: #111b2e;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: "确认卸载 A 股新股申购提醒"; color: #f8fafc; font-size: 21px; font-weight: 700; wrap: word-wrap; }
                Text {
                    text: "程序将退出并调用 Windows Installer。默认保留当前用户的数据，方便以后重新安装后继续使用。";
                    color: #cbd5e1;
                    wrap: word-wrap;
                }
                Toggle { label: "MSI 卸载成功后，同时删除当前用户数据"; checked <=> root.uninstall-purge-data; }
                if root.uninstall-purge-data : VerticalBox {
                    spacing: 8px;
                    Text {
                        text: "此操作会永久删除 %LocalAppData%\\StockIpoReminder 中的数据库、设置、公告缓存、日志和备份，且不会删除其他 Windows 用户的数据。请输入：删除当前用户数据";
                        color: #fca5a5;
                        wrap: word-wrap;
                    }
                    LineEdit {
                        text <=> root.uninstall-confirmation-text;
                        placeholder-text: "删除当前用户数据";
                    }
                }
                Text { text: "Windows 可能显示管理员权限确认。只有 MSI 成功卸载后，助手才会执行已确认的数据清理。"; color: #fcd34d; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "取消"; clicked => { root.show-uninstall-confirmation = false; } }
                    ActionButton {
                        label: root.uninstall-purge-data ? "卸载并删除数据" : "卸载并保留数据";
                        danger: true;
                        enabled: !root.uninstall-purge-data || root.uninstall-confirmation-text == "删除当前用户数据";
                        clicked => {
                            root.request-uninstall(root.uninstall-purge-data, root.uninstall-confirmation-text);
                        }
                    }
                }
            }
        }
    }

    if root.show-exit-confirmation : Rectangle {
        background: #b0020617;
        Rectangle {
            width: 560px;
            height: 250px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: #dc2626;
            background: #111b2e;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text { text: "仍有未确认任务"; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text {
                    text: "今天仍有 " + root.pending-count + " 只新股没有确认申购。退出后程序无法继续提醒，确定退出吗？";
                    color: #cbd5e1;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalBox {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "取消"; clicked => { root.show-exit-confirmation = false; } }
                    ActionButton { label: "仍然退出"; danger: true; clicked => { root.exit-app(); } }
                }
            }
        }
    }
}

export component ReminderWindow inherits Window {
    title: root.window-title;
    preferred-width: 560px;
    preferred-height: 360px;
    min-width: 460px;
    min-height: 300px;
    // Keep the complete reminder surface invalidatable after its native
    // no-activate window is shown and moved into the work area.
    background: Math.mod(root.repaint-token, 2) == 0 ? #3a2510 : #3a2511;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    always-on-top: true;

    in-out property <int> repaint-token: 0;
    in-out property <string> window-title: "A 股打新提醒";
    in-out property <string> reminder-kind: "ipo";
    in-out property <string> reminder-title: "打新提醒";
    in-out property <string> reminder-body: "";
    in-out property <string> reminder-event-id: "";
    in-out property <string> reminder-source-id: "";
    in-out property <string> reminder-cycle-key: "";
    in-out property <string> reminder-open-label: "打开详情";
    // 由 Rust 决定「打开」按钮进理财页还是今日任务：健康摘要与通知测试的 kind
    // 既不是 ipo 也不是理财，界面按 kind 猜分类会把它们送错页面。
    in-out property <bool> reminder-opens-finance: false;
    // 提醒自身的日期（YYYY-MM-DD）。动作只作用于这一天，绝不能拿点击当天顶替。
    in-out property <string> reminder-event-date: "";
    in-out property <string> primary-action-label: "";
    in-out property <bool> primary-action-enabled: false;
    in-out property <int> reminder-event-version: 0;
    in-out property <int> batch-count: 1;
    in-out property <bool> can-acknowledge: false;

    callback open-details(string);
    callback open-finance(string, string);
    callback request-acknowledgement(string, int);
    callback request-finance-action(string, string, string, string);
    callback dismiss();

    Rectangle {
        border-width: 2px;
        border-color: #e7a52d;
        background: #3a2510;
        VerticalBox {
            padding: 20px;
            spacing: 14px;
            Text {
                text: root.reminder-title;
                color: #fcd34d;
                font-size: 23px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Rectangle {
                border-radius: 9px;
                border-width: 1px;
                border-color: #694817;
                background: #24190d;
                vertical-stretch: 1;
                ScrollView {
                    Text {
                        text: root.reminder-body;
                        color: #f8fafc;
                        wrap: word-wrap;
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                    }
                }
            }
            HorizontalBox {
                spacing: 10px;
                ActionButton {
                    label: root.reminder-open-label;
                    clicked => {
                        if root.reminder-opens-finance {
                            root.open-finance(root.reminder-kind, root.reminder-source-id);
                        } else {
                            root.open-details(root.reminder-event-id);
                        }
                    }
                }
                if root.can-acknowledge : ActionButton {
                    label: "确认已申购";
                    primary: true;
                    clicked => {
                        root.request-acknowledgement(
                            root.reminder-event-id,
                            root.reminder-event-version
                        );
                    }
                }
                if root.primary-action-enabled : ActionButton {
                    label: root.primary-action-label;
                    primary: true;
                    clicked => {
                        root.request-finance-action(
                            root.reminder-kind,
                            root.reminder-source-id,
                            root.reminder-cycle-key,
                            root.reminder-event-date
                        );
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { label: "稍后处理"; clicked => { root.dismiss(); } }
            }
        }
    }
}
